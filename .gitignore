# Data (fetched via fetch_scripts/fetch_nhs.py; re-fetchable from the manifest) — never commit
data/


# Virtual environment
.venv/
venv/

autocommit.log
.autocommit.pid

# LaTeX build artifacts — the report .tex (source) and .pdf are kept; aux files are not.
# (tectonic leaves none, but pdflatex/latexmk would.)
reports/*.aux
reports/*.log
reports/*.toc
reports/*.out
reports/*.lof
reports/*.lot
reports/*.fls
reports/*.fdb_latexmk
reports/*.synctex.gz

# EPUB build intermediates (build_epub.py regenerates and cleans these)
reports/epub.css
reports/.eda_report_epub.tex
